{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["../lib/*"],
      // lib/ sits outside this app, so its tests can't walk up to admin's vitest
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src", "../lib"]
}
