{
  "title": "Remove the top cover of the Olympus OM10",
  "manufacturer": "Olympus",
  "model": "OM10",
  "description": "A guide to removing the top cover of the Olympus OM10",
  "tools": [
    "JIS Screwdriver",
    "Circlip Pliers / Small flathead screwdriver",
    "Soldering Iron"
  ],
  "steps": [
    {
      "title": "Remove the screws from around the top cover",
      "intro": "There are 6 screws to remove. Two long ones at the front and four shorter ones on the sides and back.",
      "substeps": [
        {
          "text": "Remove the two long screws from the front",
          "bulletStyle": "red"
        },
        {
          "text": "Remove the four short screws from the sides and back",
          "bulletStyle": "blue"
        }
      ],
